{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(git push *)",
      "Read(./library/restricted/**)",
      "Read(./okf/restricted/**)",
      "Read(./inbox/restricted/**)",
      "Read(./data/**)",
      "Read(./exports/**)",
      "Read(./quarantine/**)",
      "Bash(* ./okf/restricted*)",
      "Bash(* okf/restricted*)",
      "Bash(* ./library/restricted*)",
      "Bash(* library/restricted*)",
      "Bash(* ./inbox/restricted*)",
      "Bash(* inbox/restricted*)",
      "Bash(* data/*)",
      "Bash(sqlite3 *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "env": {
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1"
  }
}
